# Database URLs (directUrl connects directly to PostgreSQL primary, DATABASE_URL connects via PgBouncer)
DATABASE_URL="postgresql://rota_app:placeholder@localhost:6432/rota_s0?pgbouncer=true&connection_limit=15&pool_timeout=10"
DIRECT_DATABASE_URL="postgresql://rota_owner:placeholder@localhost:5432/rota_s0"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Secret (minimum 32 bytes)
JWT_SECRET="placeholder-jwt-secret-at-least-32-characters-long"
JWT_PREVIOUS_SECRET=""

# Card Token Encryption Key (32-byte hex/base64 string)
CARD_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Flutterwave Test Keys
FLW_SECRET_KEY="FLWSECK_TEST-placeholder"
FLW_PUBLIC_KEY="FLWPUBK_TEST-placeholder"
FLW_SECRET_HASH="placeholder-webhook-hash"

# Demo Host / Web Domain for reset and invite landing pages
DEMO_HOST="localhost:3000"

# Mobile App Public Config
EXPO_PUBLIC_API_URL="http://localhost:3000/v1"
EXPO_PUBLIC_PROJECT_ID="placeholder-expo-project-id"
